    location: https://github.com/rowanG077/hint.git
    tag: cfcf1a5fd1663399f77f73a5866ead21536fc406

  -- Waiting for upstream: https://github.com/nomeata/inspection-testing/pull/102
  source-repository-package
    type: git
    location: https://github.com/rowanG077/inspection-testing.git
    tag: b38452dda0cb13991bbe6749810fb18f0dbfbbda

  -- Waiting for upstream: https://github.com/snoyberg/mono-traversable/pull/262
  source-repository-package
    type: git
    location: https://github.com/rowanG077/mono-traversable.git
    tag: 1b7777a104cd326840e945480bcc954b69ad03c8

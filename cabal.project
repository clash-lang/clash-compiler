    location: https://github.com/rowanG077/first-class-families.git
    tag: 423173d74b5bb7a1fa706f25a1da386ecaeb5acb

  -- GHC 10.0 support pending upstream: https://github.com/alanz/ghc-exactprint
  source-repository-package

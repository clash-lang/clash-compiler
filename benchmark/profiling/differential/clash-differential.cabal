cabal-version:       2.2
name:                clash-differential
version:             0.0.0
synopsis:            Compare serialized designs of scoped Clash Core
description:
  Compares the normalized bindings of serialized designs from two runs, and
  checks the round trip through the Binary instances of scoped Clash Core.
  See README.md.
homepage:            https://clash-lang.org/
license:             BSD-2-Clause
author:              QBayLogic B.V.
category:            Testing
build-type:          Simple

executable clash-differential
  main-is:             clash-differential.hs
  hs-source-dirs:      .
  other-modules:       Compare
                       Normalized
                       RoundTrip
  default-language:    Haskell2010
  ghc-options:         -O2 -Wall -Wcompat -rtsopts "-with-rtsopts=-A64m"
  build-depends:       base,
                       binary,
                       containers,
                       filepath,
                       text,

                       clash-lib,
                       clash-profiling-prepare

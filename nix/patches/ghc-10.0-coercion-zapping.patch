    = GRefl r t1 (MCo $ mkTransCo kco1 kco2)
 
+   -- Important performance optimisation: propagate zappedness.
+   -- See Note [Propagating zappedness].
+   | UnivCo { uco_prov = ZappedProv, uco_role = r
+            , uco_lty = lty, uco_deps = deps1 } <- co1
+   = assert_same_role $
+     case co2 of
+       UnivCo { uco_prov = ZappedProv, uco_rty = rty2, uco_deps = deps2 }
+         -> mk_zapped_co (deps1 `unionUnivCoDeps` deps2) r lty rty2
+       _ -> let rty = coercionRKind co2
+            in mk_zapped_co (addUnivCoTypeDeps [rty] $ deps1 `addUnivCoDep` co2)
+                            r lty rty
+   | UnivCo { uco_prov = ZappedProv, uco_role = r
+            , uco_rty = rty, uco_deps = deps2 } <- co2
+   = assert_same_role $
+     let lty = coercionLKind co1
+     in mk_zapped_co (addUnivCoTypeDeps [lty] $ deps2 `addUnivCoDep` co1)
+                     r lty rty
+
    | otherwise
    = TransCo co1 co2
+   where
+     -- Establishing (UnivCoDepsInv) for the result:
+     --   * an endpoint taken from a zapped coercion is covered by its own 'uco_deps';
+     --   * an endpoint taken from a non-zapped 'co' is covered by
+     --     'addUnivCoDep co' with the exception of those that only appear in
+     --     it LHS or RHS type, so we add those on explicitly.
+     mk_zapped_co = mkUnivCoFromDeps ZappedProv
+
+     -- See Note [Core Lint and zapped coercions] in GHC.Tc.Solver.Rewrite.
+     assert_same_role :: Coercion -> Coercion
+     assert_same_role =
+       assertPpr (coercionRole co1 == coercionRole co2) $
+         vcat [ text "mkTransCo: role mismatch when propagating zappedness"
+              , text "co1:" <+> ppr co1
+              , text "co2:" <+> ppr co2 ]
 
